# =============================================================================
# JOL RAG Stack — Environment Variables Template
# Copy to .env and populate all CHANGE_ME values before deployment.
# NEVER commit .env to version control.
#
# Pilot: fill values manually (openssl rand -hex 32).
# Production: use scripts/vault-inject-secrets.sh (Vault is source of truth).
# =============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME=jol-rag

# --- Qdrant ---
QDRANT_API_KEY=CHANGE_ME_openssl_rand_hex_32

# --- MinIO ---
MINIO_ROOT_USER=jol-rag-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_32
MINIO_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- JWT Authentication ---
RAG_JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
RAG_JWT_ALGORITHM=HS256
RAG_JWT_ISSUER=jol-rag-pilot
RAG_JWT_AUDIENCE=jol-rag-services
RAG_JWT_EXPIRY_MINUTES=60

# --- HMAC Pseudonymisation Salt (GDPR Art. 25) ---
RAG_HMAC_SALT=CHANGE_ME_openssl_rand_hex_32

# --- Application ---
RAG_ENVIRONMENT=production
RAG_LOG_LEVEL=INFO
RAG_AUDIT_LOG_PATH=/var/log/rag/audit.jsonl
RAG_RAW_DOCS_DIR=/data/raw_docs

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM (Ollama on llm-prod-lt01, VLAN 30) ---
OLLAMA_ENDPOINT=http://10.30.30.10:11434/v1
OLLAMA_MODEL=mistral-7b-instruct

# --- Qdrant Connection ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=jol-documents

# --- MinIO Connection ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_DOCUMENTS=jol-documents
MINIO_USE_SSL=false

# --- Redis Connection ---
# REDIS_URL is injected by docker-compose from ${REDIS_PASSWORD} — never set it
# here. Duplicating the credential across config surfaces was the exposure
# vector in the 2026-08-07 incident; see docs/deployments/2026-08-07-rag-prod-lt01.md.

# --- Rate Limiting (global, per client IP) ---
RAG_RATE_LIMIT_REQUESTS=100
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# --- Rate Limiting (per authenticated user, per role scope) ---
RAG_RATE_LIMIT_QUERY_PER_MIN=100
RAG_RATE_LIMIT_INGEST_PER_MIN=10
RAG_RATE_LIMIT_ADMIN_PER_MIN=20

# --- Internal mTLS (service-to-service) ---
# Enable after running: make certs (scripts/tls/generate-mtls-certs.sh)
RAG_INTERNAL_TLS_ENABLED=false
QDRANT_TLS_ENABLED=false
# RAG_TLS_CA_CERT=/etc/rag-tls/ca.crt
# RAG_TLS_CLIENT_CERT=/etc/rag-tls/rag-api-client.crt
# RAG_TLS_CLIENT_KEY=/etc/rag-tls/rag-api-client.key
# When TLS is enabled, point Ollama at the mTLS proxy on llm-prod-lt01:
# OLLAMA_ENDPOINT=https://10.30.30.10:8443/v1

# --- Query Cache (Redis, GDPR-purgeable) ---
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=900

# --- SIEM Shipping (filebeat, compose profile 'siem') ---
SIEM_LOGSTASH_HOST=siem.jol.internal:5044

# --- GDPR Compliance ---
RAG_EMBEDDING_TTL_DAYS=90
RAG_DELETION_GRACE_PERIOD_DAYS=30
