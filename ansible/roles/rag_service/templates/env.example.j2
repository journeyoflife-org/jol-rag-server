# =============================================================================
# JOL RAG Stack — Environment Template
# Managed by Ansible. Copy to .env and populate secrets before deployment.
# NEVER commit .env to version control.
# =============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME={{ rag_compose_project }}

# --- Qdrant ---
QDRANT_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- MinIO ---
MINIO_ROOT_USER=jol-rag-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
MINIO_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- JWT Authentication ---
RAG_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
RAG_JWT_ALGORITHM={{ rag_jwt_algorithm }}
RAG_JWT_ISSUER=jol-rag-pilot
RAG_JWT_AUDIENCE=jol-rag-services
RAG_JWT_EXPIRY_MINUTES=60

# --- HMAC Pseudonymisation Salt ---
RAG_HMAC_SALT=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Application ---
RAG_ENVIRONMENT=production
RAG_LOG_LEVEL=INFO
RAG_AUDIT_LOG_PATH=/var/log/rag/audit.jsonl
RAG_RAW_DOCS_DIR=/data/raw_docs

# --- Embedding Model ---
EMBEDDING_MODEL={{ embedding_model }}
EMBEDDING_DIMENSION={{ embedding_dimension }}

# --- LLM (Ollama) ---
OLLAMA_ENDPOINT={{ ollama_endpoint }}
OLLAMA_MODEL={{ ollama_model }}

# --- Qdrant Connection ---
QDRANT_HOST=qdrant
QDRANT_PORT={{ qdrant_port }}
QDRANT_COLLECTION={{ qdrant_collection_name }}

# --- MinIO Connection ---
MINIO_ENDPOINT=minio:{{ minio_api_port }}
MINIO_BUCKET_DOCUMENTS={{ minio_bucket_documents }}
MINIO_USE_SSL=false

# --- Redis Connection ---
REDIS_URL=redis://:CHANGE_ME@redis:{{ redis_port }}/0

# --- Rate Limiting (global, per client IP) ---
RAG_RATE_LIMIT_REQUESTS=100
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# --- Rate Limiting (per authenticated user, per role scope) ---
RAG_RATE_LIMIT_QUERY_PER_MIN=100
RAG_RATE_LIMIT_INGEST_PER_MIN=10
RAG_RATE_LIMIT_ADMIN_PER_MIN=20

# --- Internal mTLS (service-to-service) ---
RAG_INTERNAL_TLS_ENABLED={{ rag_internal_tls_enabled | default(false) | lower }}
QDRANT_TLS_ENABLED={{ rag_internal_tls_enabled | default(false) | lower }}

# --- Query Cache (Redis, GDPR-purgeable) ---
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=900

# --- SIEM Shipping (filebeat, compose profile 'siem') ---
SIEM_LOGSTASH_HOST={{ siem_logstash_host | default('siem.jol.internal:5044') }}

# --- GDPR ---
RAG_EMBEDDING_TTL_DAYS=90
RAG_DELETION_GRACE_PERIOD_DAYS=30
